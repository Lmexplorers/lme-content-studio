# Nathalie AI-widgeten (delt JS uten cache-bust-versjonsnummer) endres av og
# til, og nettleseren/CDN-en kan da sitte igjen med en gammel, ufiksed utgave
# lenge etter en frisk utrulling (samme mønster som bet oss på lme-platform).
/lme-bot-core.js
  Cache-Control: no-store
/lme-bot-shell-content-studio.js
  Cache-Control: no-store

# Selve appsidene (no.html/en.html, apnes som /no og /en) endres svaert ofte
# akkurat na under feilretting, og har ingen egen cache-bust-versjonering.
# Uten dette kan Renate teste en fiks rett etter push og fortsatt se den
# gamle, ufiksede siden fra buffer.
/no
  Cache-Control: no-store
/no.html
  Cache-Control: no-store
/en
  Cache-Control: no-store
/en.html
  Cache-Control: no-store
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
